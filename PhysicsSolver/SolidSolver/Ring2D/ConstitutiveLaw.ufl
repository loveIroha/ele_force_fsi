from ufl import *

mu = 1.0
gamma = 0.1
omega = 0.0625
R = 0.25

((R+omega)*(R+omega+gamma) - R*(R+gamma)-omega*omega)/2/omega

cell = triangle
element = VectorElement("Lagrange", cell, 1)
real = FiniteElement("Real", cell, 0)

U = TrialFunction(element)
V = TestFunction(element)

# 参数
mu = mu/omega
lamb = 2.0

# 已知变量，例如位移
X = Coefficient(element)

# 形变梯度及其相关变量
FF = grad(X)+Identity(len(X))
CC = FF.T*FF
JJ = det(FF)

# 第一PK应力张量
PP = mu*(FF-inv(FF).T)

# 增加不可压条件 
# PP += lamb*ln(JJ)*inv(FF).T

# 弱形式
F = inner(PP, grad(V))*dx + inner(U, V)*dx


# 双线性型及右端项
a = lhs(F)
L = rhs(F)

element = VectorElement("Lagrange", triangle, 1)
real = FiniteElement("Real", triangle, 0)

U = TrialFunction(element)
V = TestFunction(element)

# 参数
beta = Coefficient(real)
eta = Coefficient(real)
dt = Coefficient(real)
mu = Coefficient(real)
lamb = 1.0

# 已知变量，例如位移
X = Coefficient(element)

# 形变梯度及其相关变量
FF = grad(X)+Identity(len(X))
CC = FF.T*FF
JJ = det(FF)

# 第一PK应力张量
PP = mu*(FF-inv(FF).T)




# 弱形式
F = inner(PP, grad(V))*dx + inner(U, V)*dx


# 双线性型及右端项
a = lhs(F)
L = rhs(F)

from ufl import *

mu = 1.0
gamma = 0
omega = 0.0625
R = 0.25

cell = triangle
element = VectorElement("Lagrange", cell, 1)
real = FiniteElement("Real", cell, 0)

U = TrialFunction(element)
V = TestFunction(element)
s = Coefficient(element)
# X0 = SpatialCoordinate(cell)

# s2 = sqrt((X[1]+X0[1]-0.5)*(X[1]+X0[1]-0.5) +
#           (X[0]+X0[0]-0.5)*(X[0]+X0[0]-0.5))-R
# s1_temp = R*acos((X[0]+X0[0]-0.5)/(R+s2))

# s1 = conditional(le(X[1]+X0[1], 0.5), 2*pi*R - s1_temp, s1_temp)


r = as_vector((-cos(s[0]/R), -sin(s[0]/R)))
G = mu/omega/(1+s[1])/R*r

H = - inner(G, V)*dx + inner(U, V)*dx
a = lhs(H)
L = rhs(H)
